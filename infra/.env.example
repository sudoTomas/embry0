# =============================================================================
# embry0 compose interpolation: copy to infra/.env
# =============================================================================
# Compose reads this file when it runs from infra/ or with
# -f infra/docker-compose.yml: infra/deploy.sh, the systemd unit and the
# CONTRIBUTING full-stack recipe all do. It feeds the ${...} references in
# docker-compose.yml and is loaded into no container. Secrets the containers
# read go in the repo-root .env (docs/adr/0005-two-env-files.md).
#
# `embry0 start` passes --env-file with the root .env, which then serves both
# roles, and reads this file only when it sets COMPOSE_FILE: it then composes
# the files listed and passes this file to compose after the root one, so an
# overlay's variables (SANDBOX_DOCKER_GID) are found here. Keep the values both
# files carry (POSTGRES_*, MINIO_ROOT_*, CLOUDFLARED_TUNNEL_TOKEN) equal.
#
# Every variable docker-compose.yml interpolates has an entry here, set or
# commented out at its default; tests/unit/infra/test_env_templates.py keeps
# it that way.

# --- Optional services ---
# Compose profiles to run, comma-separated:
#   webhook-tunnel    cloudflared, the webhook tunnel (CLOUDFLARED_TUNNEL_TOKEN below)
#   dashboard-tunnel  cloudflared-dashboard, the public dashboard tunnel (docs/sso.md)
#   offhost-backup    offhost-backup, copies backups off this host (OFFHOST_BACKUP_* below)
# Never list `images`: those services only build (docker compose --profile images build).
# COMPOSE_PROFILES=webhook-tunnel

# --- Sandbox runtime (optional, docs/ops/provisioning.md) ---
# The default runs sandboxes in the privileged `dind` service. To run them on
# a dedicated rootless Docker daemon instead (AGENT_RUNTIME=rootless), set it
# up with infra/rootless/provision-sandbox-daemon.sh, then add the overlay and
# the sandbox account's gid (the script prints it):
# COMPOSE_FILE=docker-compose.yml:docker-compose.rootless.yml
# SANDBOX_DOCKER_GID=
# The host directory the rootless overlay mounts as the skills store; it must
# exist, be writable by the orchestrator and readable by the sandbox account
# (docs/ops/provisioning.md). Default:
# SKILLS_STORE_HOST=/var/lib/embry0/skills

# --- Database (required) ---
# The same value as POSTGRES_PASSWORD in the root .env. Compose splices it into
# the orchestrator's DATABASE_URL, so use only A-Z a-z 0-9 _ - .
# Generate with: openssl rand -hex 20
POSTGRES_PASSWORD=
POSTGRES_USER=embry0
POSTGRES_DB=embry0

# --- MinIO, QA artifact storage (required) ---
# The same values as in the root .env. Generate with: openssl rand -hex 16
MINIO_ROOT_USER=embry0
MINIO_ROOT_PASSWORD=

# --- Port, resources, time zone (compose defaults shown) ---
# The dashboard's port on the host. infra/deploy.sh also reads it here.
# PROD_PORT=8200
# ORCHESTRATOR_CPUS=4
# ORCHESTRATOR_MEMORY=4G
# DIND_CPUS=4
# DIND_MEMORY=8G
# TZ=America/New_York

# --- Proxies the orchestrator trusts for X-Forwarded-For ---
# nginx (.10) and the dashboard tunnel (.11) on the pinned frontend network.
# Change it only together with that network's subnet in docker-compose.yml.
# FORWARDED_ALLOW_IPS=172.29.0.10,172.29.0.11

# --- Private CA for a self-managed GitLab (optional) ---
# The PEM's path on the host, mounted read-only at /etc/embry0/gitlab-ca.pem.
# Set it together with GITLAB_CA_BUNDLE=/etc/embry0/gitlab-ca.pem in the root
# .env, or set neither (docs/configuration.md).
# GITLAB_CA_BUNDLE_HOST=/etc/ssl/private/internal-ca.pem

# --- Webhook tunnel (optional, profile webhook-tunnel, docs/webhooks.md) ---
# The Cloudflare tunnel token. Put it in the root .env as well.
# CLOUDFLARED_TUNNEL_TOKEN=

# --- Public dashboard (optional, docs/sso.md) ---
# The public dashboard's hostname, with no scheme, port or path. Set, nginx
# serves that Host from a hardened vhost, and the dashboard-tunnel profile
# routes it. Unset, there is no public vhost.
# DASHBOARD_PUBLIC_HOSTNAME=embry0.example.com
# Written by infra/cloudflared-dashboard/provision.sh, which also reads
# CF_API_TOKEN (a zone-admin token for the dashboard's zone) from here.
# CF_TUNNEL_ID=
# CF_RUN_USER=
# CF_API_TOKEN=

# --- Off-host backup (optional, profile offhost-backup, docs/ops/backup-restore.md) ---
# Copies the daily Postgres dumps and every MinIO bucket to an S3-compatible
# bucket you own, off this host. Off until you add offhost-backup to
# COMPOSE_PROFILES and set OFFHOST_BACKUP_S3_PATH. Set both: the path also
# arms the staleness alert (embry0_offhost_backup_enabled), so a path with the
# profile off fires the alert, and the profile with no path exits with an error.
# The copy only adds and updates objects; set retention as a lifecycle rule on
# the bucket. The key needs list, read and write on the path, not delete.
# OFFHOST_BACKUP_S3_PATH=my-backups/embry0
# OFFHOST_BACKUP_S3_ENDPOINT=https://s3.example.com
# rclone's S3 provider name: AWS, Cloudflare, Wasabi, Minio, ... or Other.
# OFFHOST_BACKUP_S3_PROVIDER=Other
# OFFHOST_BACKUP_S3_REGION=
# OFFHOST_BACKUP_S3_ACCESS_KEY_ID=
# OFFHOST_BACKUP_S3_SECRET_ACCESS_KEY=
# Seconds between passes. The staleness alert assumes the default.
# OFFHOST_BACKUP_INTERVAL_SECONDS=3600
