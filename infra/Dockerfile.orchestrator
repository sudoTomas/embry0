# The uv that reads uv.lock: CI's UV_VERSION (.github/workflows/ci.yml), by
# digest. RUN steps below mount its one binary; it is never copied into the
# image.
FROM ghcr.io/astral-sh/uv:0.11.17@sha256:03bdc89bb9798628846e60c3a9ad19006c8c3c724ccd2985a33145c039a0577b AS uv

FROM python:3.12.15-slim-bookworm

# Upgrade OS packages first: a pinned base tag can ship a CRITICAL whose fix
# is already in the Debian repos. A build reuses this layer from its cache, so
# it never sees a fix published later; raising OS_PACKAGES_REFRESHED rebuilds
# it (docs/ops/deploy.md, "Refreshing OS packages").
ARG OS_PACKAGES_REFRESHED=2026-10-28
RUN echo "OS packages as of ${OS_PACKAGES_REFRESHED}" \
    && apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates gnupg libpq-dev openssh-client \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
       https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies, at exactly the versions uv.lock pins (#286): the ones
# CI tests. Installing from pyproject's ranges gave each build whatever was
# newest inside them, so an image could run a version CI never ran. uv
# exports the lock (--locked refuses one that no longer matches pyproject,
# --no-dev leaves the dev extra out) and pip installs it with every hash
# checked; psycopg[binary] comes from pyproject through the lock like the
# rest. pip, not `uv sync`, stays the installer: the layout, the bytecode it
# compiles and the editable install below are what they were. A dependency
# bump reaches the image only as a change to uv.lock.
#
# Only pyproject, the lock and a stub package are copied here so this layer
# caches across source changes; the full source lands further down.
#
# EDITABLE install (#334): `pip install .` at this point copied the STUB into
# site-packages (embry0/__init__.py and nothing else). Console scripts put
# their own directory on sys.path, not the cwd, so `embry0 …` imported that
# stub and died with "No module named 'embry0.cli'", while uvicorn (which adds
# the cwd) ran the real tree from /app — two copies of one package, picked by
# import order. `-e` writes a .pth that points at /app instead: site-packages
# holds metadata only (console scripts + the embry0.workspace_* entry points),
# and /app is the ONE copy every entry path imports, data files included.
#
# README.md is a stub too: hatchling reads pyproject's `readme` to build the
# metadata and fails if the file is missing. The real one is not in the build
# context (.dockerignore drops *.md), and copying it would re-run this layer
# on every docs edit. The image never shows the long description.
#
# `--no-deps -e .` installs the project and nothing else: its dependencies are
# all in the lock, and the drift check at the end of this file fails the
# build if the two ever disagree.
COPY pyproject.toml uv.lock /app/
COPY embry0/__init__.py /app/embry0/__init__.py
WORKDIR /app
RUN --mount=from=uv,source=/uv,target=/opt/uv/uv \
    /opt/uv/uv export --locked --no-dev --no-emit-project --no-cache --quiet \
        --output-file /tmp/requirements.lock.txt \
    && pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock.txt \
    && rm /tmp/requirements.lock.txt \
    && touch README.md && pip install --no-cache-dir --no-deps -e .

# Install Node.js. No Claude CLI here (#497): the orchestrator never runs an
# agent — every query() runs in a sandbox image, on the CLI bundled in that
# image's claude-agent-sdk — so an npm @anthropic-ai/claude-code here was a
# second, unused CLI version.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    # npm self-upgrade — nodesource bundles an npm whose vendored tar carries
    # CRITICAL CVE-2026-59873 (fixed in tar >= 7.5.19).
    && npm install -g npm@latest

# Application code (overwrite with full source)
COPY embry0/ /app/embry0/
# The hosted MCP endpoint (embry0-mcp-http, compose service `mcp`) runs from
# this image too: embry0/mcp_server/ rides this copy.

# Non-root user
RUN useradd --create-home orchestrator \
    && mkdir -p /data /skills \
    && chown orchestrator:orchestrator /data /skills

USER orchestrator

# Inside this image the API is on :8000 (the :8200 the CLI defaults to is the
# host-side nginx port). Compose `environment:` still overrides these — the
# `mcp` service points EMBRY0_API_URL at http://orchestrator:8000.
#
# PROD_PORT, not EMBRY0_URL: `embry0 health` derives its URL from PROD_PORT,
# while EMBRY0_URL is also the base for the console/board deep links that
# services/linear_dispatch.py prints, and those are nginx routes that :8000
# does not serve — setting it would hand operators 404 links.
ENV EMBRY0_API_URL=http://localhost:8000 \
    PROD_PORT=8000

# Build-time smoke (#334): fail the build, not the operator. Runs from / as the
# runtime user so nothing is found via the cwd — every import must resolve
# through the install, and must resolve to /app (a second copy in
# site-packages is the bug this guards against).
WORKDIR /
RUN embry0 --help > /dev/null \
    && embry0 build-qa-image --help > /dev/null \
    && python -c "import embry0, embry0.mcp_server.http, embry0.api.app, pathlib, sysconfig; \
assert embry0.__file__ == '/app/embry0/__init__.py', embry0.__file__; \
assert embry0.mcp_server.__file__ == '/app/embry0/mcp_server/__init__.py', embry0.mcp_server.__file__; \
sp = pathlib.Path(sysconfig.get_paths()['purelib']); \
assert not (sp / 'embry0').exists(), 'package copy in site-packages'"

# Drift check (#286), after the last install: every installed distribution
# must be the version uv.lock pins, every pin must be installed, and nothing
# may come from outside the lock but pip (the base image's) and embry0 (the
# /app tree above).
RUN --mount=from=uv,source=/uv,target=/opt/uv/uv \
    --mount=type=bind,source=infra/scripts/check-image-lock.py,target=/opt/check-image-lock.py \
    /opt/uv/uv export --project /app --frozen --no-dev --no-emit-project --no-hashes --no-cache --quiet \
        --output-file /tmp/requirements.lock.txt \
    && python /opt/check-image-lock.py /tmp/requirements.lock.txt --allow pip --allow embry0 \
    && rm /tmp/requirements.lock.txt
WORKDIR /app

EXPOSE 8000

# Exec form (hadolint DL3025): sh -c keeps the documented exit 1 on failure.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["sh", "-c", "curl --fail http://localhost:8000/health || exit 1"]

# --proxy-headers is uvicorn's default but stated explicitly: which peers'
# X-Forwarded-For is trusted comes from FORWARDED_ALLOW_IPS in the compose
# environment (RAV-1060 — pinned to the nginx/frontend network subnet).
# Without a trusted source uvicorn reports the nginx container IP as the
# client for every request, gutting per-IP rate limiting + audit actors.
CMD ["uvicorn", "embry0.api.app:create_app", "--factory", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", \
     "--log-level", "info", \
     "--timeout-graceful-shutdown", "30", \
     "--timeout-keep-alive", "65"]
