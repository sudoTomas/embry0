# Stateless proxies — same image is used for two distinct deployment shapes:
#   1. Credential-injection proxies (git, github, auth) — run inside DinD on
#      sandbox-restricted, holding orchestrator credentials.
#   2. Network-plumbing proxies (minio, presign) — run on the HOST docker daemon
#      on the backend network, giving DinD-spawned sandboxes a stable hostname
#      to reach minio:9000 and orchestrator:8000 (which are NOT visible inside
#      DinD's network namespace).
# Each container instance picks a proxy type at startup via PROXY_TYPE env var.

# The uv that reads uv.lock: CI's UV_VERSION, by digest, as in
# Dockerfile.orchestrator. Mounted into one RUN step, never copied in.
FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv

FROM python:3.12.15-slim-bookworm

# Upgrade OS packages first: a pinned base tag can ship a CRITICAL whose fix
# is already in the Debian repos. A build reuses this layer from its cache, so
# it never sees a fix published later; raising OS_PACKAGES_REFRESHED rebuilds
# it (docs/ops/deploy.md, "Refreshing OS packages").
ARG OS_PACKAGES_REFRESHED=2026-10-28
RUN echo "OS packages as of ${OS_PACKAGES_REFRESHED}" \
    && apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Three of embry0's own dependencies, at the versions uv.lock pins (#286):
# the ones CI tests and the orchestrator runs. pyproject's `proxy` dependency
# group names them, so the export of that group alone is them and
# everything they need, with hashes; pip installs it with every hash
# checked. Then the drift check, the same full check as the orchestrator's:
# every installed distribution but pip is in that export at its version,
# and every pin in it is installed. pyproject and the lock are mounted, not
# copied; the image does not carry them.
RUN --mount=from=uv,source=/uv,target=/opt/uv/uv \
    --mount=type=bind,source=pyproject.toml,target=/opt/lock/pyproject.toml \
    --mount=type=bind,source=uv.lock,target=/opt/lock/uv.lock \
    --mount=type=bind,source=infra/scripts/check-image-lock.py,target=/opt/check-image-lock.py \
    /opt/uv/uv export --project /opt/lock --locked --only-group proxy --no-emit-project --no-cache --quiet \
        --output-file /tmp/requirements.lock.txt \
    && pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock.txt \
    && python /opt/check-image-lock.py /tmp/requirements.lock.txt --allow pip \
    && rm /tmp/requirements.lock.txt

# Make the embry0 namespace importable.
RUN mkdir -p /app/embry0/execution/proxy
COPY embry0/__init__.py                           /app/embry0/__init__.py
# git_scope checks push branches with embry0/git_refs.py, the rule workspace init applies to a ref.
COPY embry0/git_refs.py                           /app/embry0/git_refs.py
COPY embry0/execution/__init__.py                 /app/embry0/execution/__init__.py
# gitlab_proxy imports embry0.execution.tls for the private-CA context (spec 1A 3.2).
COPY embry0/execution/tls.py                      /app/embry0/execution/tls.py
# xai_proxy reads 403 bodies with embry0/safety/xai_denials.py; the package __init__ imports patterns.py.
# context_proxy redacts log lines with embry0/safety/redaction.py (#294).
COPY embry0/safety/__init__.py                    /app/embry0/safety/__init__.py
COPY embry0/safety/patterns.py                    /app/embry0/safety/patterns.py
COPY embry0/safety/redaction.py                   /app/embry0/safety/redaction.py
COPY embry0/safety/xai_denials.py                 /app/embry0/safety/xai_denials.py
COPY embry0/execution/proxy/__init__.py           /app/embry0/execution/proxy/__init__.py
COPY embry0/execution/proxy/auth_proxy.py         /app/embry0/execution/proxy/auth_proxy.py
COPY embry0/execution/proxy/container_allowlist.py /app/embry0/execution/proxy/container_allowlist.py
COPY embry0/execution/proxy/context_proxy.py      /app/embry0/execution/proxy/context_proxy.py
COPY embry0/execution/proxy/enrollment.py         /app/embry0/execution/proxy/enrollment.py
COPY embry0/execution/proxy/forge_scope.py        /app/embry0/execution/proxy/forge_scope.py
COPY embry0/execution/proxy/git_proxy.py          /app/embry0/execution/proxy/git_proxy.py
COPY embry0/execution/proxy/git_scope.py          /app/embry0/execution/proxy/git_scope.py
COPY embry0/execution/proxy/github_proxy.py       /app/embry0/execution/proxy/github_proxy.py
COPY embry0/execution/proxy/gitlab_proxy.py       /app/embry0/execution/proxy/gitlab_proxy.py
COPY embry0/execution/proxy/local_llm_proxy.py    /app/embry0/execution/proxy/local_llm_proxy.py
COPY embry0/execution/proxy/minio_proxy.py        /app/embry0/execution/proxy/minio_proxy.py
COPY embry0/execution/proxy/model_request.py      /app/embry0/execution/proxy/model_request.py
COPY embry0/execution/proxy/presign_proxy.py      /app/embry0/execution/proxy/presign_proxy.py
COPY embry0/execution/proxy/receive_pack.py       /app/embry0/execution/proxy/receive_pack.py
COPY embry0/execution/proxy/xai_proxy.py          /app/embry0/execution/proxy/xai_proxy.py
COPY embry0/execution/proxy/server.py             /app/embry0/execution/proxy/server.py

# Health check via the proxy's own /health endpoint. Use Python's urllib since
# wget/curl are not present in python:3.12-slim. PORT defaults to 9100 in
# absence of PROXY_TYPE; the docker-compose / ProxyManager always sets it.
# Exec form (hadolint DL3025): sh -c keeps the documented exit 1 on failure.
HEALTHCHECK --interval=5s --timeout=3s --start-period=2s --retries=3 \
    CMD ["sh", "-c", "python -c \"import urllib.request, os; urllib.request.urlopen('http://localhost:' + os.environ.get('LISTEN_PORT','9100') + '/health')\" || exit 1"]

# Default command runs whichever proxy was selected via env at container start.
CMD ["python", "-m", "embry0.execution.proxy.server"]
