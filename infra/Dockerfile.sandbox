# The uv that reads uv.lock: CI's UV_VERSION, by digest, as in
# Dockerfile.orchestrator. RUN steps below mount its one binary; it is
# never copied into an image.
FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv

FROM python:3.12.16-slim-bookworm AS base

# Upgrade OS packages first: a pinned base tag can ship a CRITICAL whose fix
# is already in the Debian repos. A build reuses this layer from its cache, so
# it never sees a fix published later; raising OS_PACKAGES_REFRESHED rebuilds
# it (docs/ops/deploy.md, "Refreshing OS packages").
ARG OS_PACKAGES_REFRESHED=2026-10-28
RUN echo "OS packages as of ${OS_PACKAGES_REFRESHED}" \
    && apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# System dependencies — base + Playwright/Chromium runtime libraries.
#
# Without the libnss3/libgbm1/libxkbcommon0/libdrm2/etc. set, every QA
# sub-task's agent reports `Browser automation could not be executed
# (slim sandbox missing libglib-2.0.so.0, libX11.so.6, libgtk-3.so.0 …
# required by Chromium and Firefox headless shells)` and falls back to
# HTTP probing + source-code analysis. That degraded mode produces
# inconclusive results and zero screenshots — the QA agent's whole
# reason-for-being is browser automation, so these libs are required,
# not optional. List drawn from `npx playwright install-deps`'s
# bookworm package set.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates jq \
        # Playwright / Chromium runtime
        libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
        libdbus-1-3 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 \
        libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
        libasound2 libatspi2.0-0 libxshmfence1 libx11-6 libxcb1 \
        libxext6 libgtk-3-0 libglib2.0-0 \
        # Fonts so headless Chromium can render text without subs
        fonts-liberation fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js for the repositories agents work on (npm, npx). The Claude
# CLI does not need it: the Agent SDK ships its own native CLI (below).
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    # npm, pinned (#317), not the Node distribution's (its vendored tar
    # carries CRITICAL CVE-2026-59873, fixed in tar >= 7.5.19) nor npm@latest,
    # which moves under any rebuild. Bump it deliberately, in
    # Dockerfile.sandbox.qa too: CI's Trivy library gate scans what it vendors,
    # and infra/trivy/sandbox.trivyignore.yaml says what it accepts. 12.2.1
    # vendors undici 6.29.0, whose three HIGHs are fixed in 6.29.1; no npm
    # release vendors that yet, so they are accepted there until one does.
    && npm install -g npm@12.2.1

# Python packages for the sandbox runner and the code baked with it, at the
# versions uv.lock pins (#288): the ones CI tests. pyproject's `sandbox`
# dependency group names them, so the export of that group alone is them
# and everything they need, with hashes; pip installs it with every hash
# checked. Then the drift check, the same full check as the orchestrator's:
# every installed distribution but pip is in that export at its version,
# and every pin in it is installed. pyproject and the lock are mounted, not
# copied; the image does not carry them.
#
# claude-agent-sdk is the ONE source of the Claude CLI version (#497): every
# agent query() runs the CLI bundled in its wheel (claude_agent_sdk/_bundled),
# and embry0 never passes cli_path. There is no npm @anthropic-ai/claude-code
# here on purpose; a CLI bump is an SDK bump, which is a uv.lock change.
RUN --mount=from=uv,source=/uv,target=/opt/uv/uv \
    --mount=type=bind,source=pyproject.toml,target=/opt/lock/pyproject.toml \
    --mount=type=bind,source=uv.lock,target=/opt/lock/uv.lock \
    --mount=type=bind,source=infra/scripts/check-image-lock.py,target=/opt/check-image-lock.py \
    /opt/uv/uv export --project /opt/lock --locked --only-group sandbox --no-emit-project --no-cache --quiet \
        --output-file /tmp/requirements.lock.txt \
    && pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock.txt \
    && python /opt/check-image-lock.py /tmp/requirements.lock.txt --allow pip \
    && rm /tmp/requirements.lock.txt

# Sandbox code (runs inside container).
# embry0/agents/ + the docker_client/auth_provider/agent_runner subset are
# imported transitively from embry0.sandbox.runner -> executor_factory ->
# SdkAgentExecutor; the sandbox runner cannot start without them.
#
# sandbox_manager.py is intentionally NOT copied: the runner only needs
# AgentOutput (a dataclass) from agent_runner.py and never instantiates
# AgentRunner. agent_runner guards its SandboxManager import behind
# TYPE_CHECKING so loading the module does not transitively pull in
# image_registry / cache_manager / etc. — modules that don't belong inside
# the sandbox.
COPY embry0/sandbox/ /app/embry0/sandbox/
COPY embry0/safety/ /app/embry0/safety/
COPY embry0/agents/ /app/embry0/agents/
COPY embry0/execution/events.py /app/embry0/execution/events.py
COPY embry0/execution/agent_runner.py /app/embry0/execution/agent_runner.py
COPY embry0/execution/auth_provider.py /app/embry0/execution/auth_provider.py
COPY embry0/execution/docker_client.py /app/embry0/execution/docker_client.py

# Private-CA trust helper (spec 1A 3.2). Root-owned and +x; the agent user
# runs it with the PEM on stdin, and it writes the merged bundle into $HOME.
COPY infra/scripts/embry0-trust-ca /usr/local/bin/embry0-trust-ca
RUN chmod 0755 /usr/local/bin/embry0-trust-ca

# Make embry0 packages importable
RUN mkdir -p /app/embry0/execution && \
    touch /app/embry0/__init__.py /app/embry0/execution/__init__.py

ENV PYTHONPATH=/app

# Non-root user
RUN useradd --create-home agent

# Create writable workspace (tmpfs in docker run, but need the dir)
RUN mkdir -p /workspace && chown agent:agent /workspace

# The agent runner's interpreter: a copy of python the agent user may run but
# not read. The kernel starts a program its user cannot read as a process no
# other process of that user can open (/proc/<pid>/fd, mem), from its first
# instruction, so nothing a job runs can write on the runner's stdout or read
# its stdin (embry0.execution.agent_runner.RUNNER_INTERPRETER).
RUN install -o root -g root -m 0711 "$(readlink -f /usr/local/bin/python3)" /usr/local/bin/embry0-runner-python

USER agent
WORKDIR /workspace

# Fail the build, not the first agent run (#497): the SDK must support the
# Ring-3 PreToolUse hook, its bundled CLI must be the version it pins, and no
# other `claude` version may be on PATH. Runs as the agent user, with a
# throwaway HOME so the CLI leaves nothing in the image, on the runner's
# interpreter, which the agent user must be able to run and not to read.
RUN test -x /usr/local/bin/embry0-runner-python && ! test -r /usr/local/bin/embry0-runner-python \
    && home=$(mktemp -d) && HOME="$home" /usr/local/bin/embry0-runner-python -m embry0.agents.sdk_support \
    && rm -rf "$home"

# --- dev-python -------------------------------------------------------------
# Lean dev-check toolchain for Poetry-based Python repos. Same base as the
# slim sandbox: no Chromium, no Docker CLI, no JDK. Repo dependencies are
# installed per-job by the agent (`poetry install`), not baked here.
FROM base AS dev-python
USER root
# Poetry runs the target repository's checks; no embry0 code imports it.
# It and everything it needs are uv.lock's `poetry` group (#645), locked
# together with the `sandbox` group, so they share its versions and cannot
# move one. Its export is installed with every hash checked, and the stage is
# then checked against both groups: a package installed from outside them, or
# at another version, fails the build, as in the base stage.
# Poetry 2 (#331): a target repository's dev checks use its commands.
# `poetry install --no-dev` is gone (`--without dev` or `--only main`), and so
# is `poetry lock --no-update`: `poetry lock` keeps the locked versions unless
# asked (`--regenerate`). `poetry shell` and `poetry export` are plugins, not
# installed here. A lock file Poetry 1.x wrote installs as it did.
RUN --mount=from=uv,source=/uv,target=/opt/uv/uv \
    --mount=type=bind,source=pyproject.toml,target=/opt/lock/pyproject.toml \
    --mount=type=bind,source=uv.lock,target=/opt/lock/uv.lock \
    --mount=type=bind,source=infra/scripts/check-image-lock.py,target=/opt/check-image-lock.py \
    /opt/uv/uv export --project /opt/lock --locked --only-group poetry --no-emit-project --no-cache --quiet \
        --output-file /tmp/poetry.lock.txt \
    && /opt/uv/uv export --project /opt/lock --locked --only-group sandbox --only-group poetry --no-emit-project \
        --no-hashes --no-cache --quiet --output-file /tmp/image.lock.txt \
    && pip install --no-cache-dir --require-hashes -r /tmp/poetry.lock.txt \
    && python /opt/check-image-lock.py /tmp/image.lock.txt --allow pip \
    && poetry --version \
    && rm /tmp/poetry.lock.txt /tmp/image.lock.txt
USER agent
WORKDIR /workspace

# --- dev-jvm-python ---------------------------------------------------------
# Dev-check toolchain for a JVM repo whose test suites are Python:
# a Java 21 backend (backend/pom.xml) whose suites are pure pytest.
#
# Inherits Python 3.12, Node 22 and the Claude CLI from `base`; adds JDK 21
# and Poetry. Poetry comes from the same locked group as in dev-python, so a
# monorepo whose dev checks are Maven in one tree and Poetry in another can
# use one image. No Maven package: the repo ships backend/mvnw, and the wrapper
# provisions Maven itself. No Docker CLI, by design — these suites drive
# containers only through injected seams, so a real `docker` call is a bug we
# want to fail loudly rather than quietly satisfy.
#
# JDK 21 is not in Debian bookworm (main ships 17), so this uses Eclipse
# Temurin's apt repo — the same Adoptium-signed source as Dockerfile.sandbox.qa.
FROM base AS dev-jvm-python
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
    && curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
       | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb bookworm main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        temurin-21-jdk \
    && rm -rf /var/lib/apt/lists/*
# Poetry from the lock's `poetry` group, hash-checked, as in dev-python.
RUN --mount=from=uv,source=/uv,target=/opt/uv/uv \
    --mount=type=bind,source=pyproject.toml,target=/opt/lock/pyproject.toml \
    --mount=type=bind,source=uv.lock,target=/opt/lock/uv.lock \
    --mount=type=bind,source=infra/scripts/check-image-lock.py,target=/opt/check-image-lock.py \
    /opt/uv/uv export --project /opt/lock --locked --only-group poetry --no-emit-project --no-cache --quiet \
        --output-file /tmp/poetry.lock.txt \
    && /opt/uv/uv export --project /opt/lock --locked --only-group sandbox --only-group poetry --no-emit-project \
        --no-hashes --no-cache --quiet --output-file /tmp/image.lock.txt \
    && pip install --no-cache-dir --require-hashes -r /tmp/poetry.lock.txt \
    && python /opt/check-image-lock.py /tmp/image.lock.txt --allow pip \
    && poetry --version \
    && rm /tmp/poetry.lock.txt /tmp/image.lock.txt
USER agent
WORKDIR /workspace
