# QA sandbox image — extends embry0-sandbox with the runtimes the QA agent
# needs to boot and validate full-stack apps: Java JDK 21, Docker CLI (for
# DinD compose stacks), both browser backends (Playwright + Chromium and
# Vibium + Chrome for Testing — see docs/glossary.md#browser-backend),
# qa-compose wrapper.

FROM python:3.12.15-slim-bookworm

# Upgrade OS packages first — the pinned base tag ships a CRITICAL OpenSSL
# (CVE-2026-31789) whose fix is already in the Debian repos.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# System dependencies — superset of embry0-sandbox plus tooling needed
# for browser automation and JVM apps. JDK 21 isn't in Debian bookworm
# (main ships JDK 17, backports has nothing newer), so we use Eclipse
# Temurin's apt repo — the standard Adoptium-signed OpenJDK 21 build.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
    # Adoptium Temurin apt source for JDK 21.
    && curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
       | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb bookworm main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        git jq \
        # Playwright / Chromium runtime libs (matches @playwright/mcp's built-in browser):
        libglib2.0-0 libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 \
        libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 \
        libxext6 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
        libasound2 libatspi2.0-0 \
        # JVM apps (macro-lab style):
        temurin-21-jdk \
    # Docker CLI only — no daemon. Talks to DinD over TCP+TLS.
    && curl -fsSL https://download.docker.com/linux/static/stable/"$(uname -m)"/docker-29.6.2.tgz \
       | tar -xz --strip-components=1 -C /usr/local/bin docker/docker \
    && chmod +x /usr/local/bin/docker \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL https://github.com/docker/compose/releases/download/v5.3.1/docker-compose-linux-"$(uname -m)" \
       -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose \
    && ln -s /usr/local/lib/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose \
    && rm -rf /var/lib/apt/lists/*

# Pre-set the Playwright browsers path BEFORE installing playwright via npm —
# otherwise the postinstall hook may drop Chromium in /root/.cache/ms-playwright
# and we'd waste ~150 MB plus build time re-downloading it to /opt/playwright.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright

# Same trick for Vibium: pin its browser cache to a system path BEFORE
# `vibium install` so Chrome for Testing lands somewhere every user can read
# (default would be root's XDG cache, invisible to the non-root agent user).
ENV VIBIUM_CACHE_DIR=/opt/vibium

# Node.js — required for @playwright/mcp and vibium. Not for the Claude CLI:
# the Agent SDK ships its own native CLI (below).
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    # npm self-upgrade — nodesource bundles an npm whose vendored tar carries
    # CRITICAL CVE-2026-59873 (fixed in tar >= 7.5.19).
    && npm install -g npm@latest \
    # vibium is pinned EXACTLY (not @latest): it's CalVer with nightlies, its
    # behavior shifts between releases (storage-state shape, pipe transport),
    # and the QA browser-backend contract is validated against this version.
    # 26.8.21 is the hard floor — it fixes storage restore (upstream #217)
    # and a pipe-transport hang. Bumps are deliberate one-line changes.
    # See docs/spikes/2026-08-27-vibium-browser-backend.md (#229/#231).
    && npm install -g @playwright/mcp@latest playwright@latest vibium@26.8.21

# Pre-fetch Chromium so the QA agent doesn't pay download cost at job start.
# Critically: install via @playwright/mcp's BUNDLED playwright-core (not the
# standalone playwright package's). They pin different chromium revisions
# (mcp@0.0.73 -> chromium-1222, standalone playwright@latest -> chromium-1217)
# and MCP's launcher only looks for the version its own playwright-core
# expects. Using the wrong copy here causes "BrowserIsNotInstalled" at runtime.
#
# Also a+rwX (not a+rX): Playwright MCP creates a per-launch user-data-dir
# (mcp-chrome-XXXX) under PLAYWRIGHT_BROWSERS_PATH at runtime — the dir must
# be writable by the non-root agent user.
RUN node /usr/lib/node_modules/@playwright/mcp/node_modules/playwright-core/cli.js install chromium \
    && chmod -R a+rwX /opt/playwright

# Pre-fetch Vibium's Chrome for Testing + chromedriver into VIBIUM_CACHE_DIR.
# Sandboxes have no internet egress at job time, so the browser MUST be baked
# here (downloads are checksum-verified as of vibium 26.8.21). a+rwX for the
# same reason as /opt/playwright: per-launch profile dirs are created under
# the cache by the non-root agent user at runtime. Chrome refuses its own
# sandbox when run as root in DinD — the orchestrator injects
# VIBIUM_CHROME_ARGS=--no-sandbox per job (see browser_backends.py, #233);
# it is deliberately NOT baked as an ENV here so non-QA uses of the image
# don't silently inherit a weakened browser.
RUN vibium install \
    && chmod -R a+rwX /opt/vibium

# Python deps — same set as the slim image. MinIO uploads from inside the
# sandbox use presigned URLs via curl/httpx, so no MinIO SDK is needed here.
# claude-agent-sdk is the ONE source of the Claude CLI version, as in the slim
# image (#497): agents run the CLI bundled in its wheel; no npm claude-code.
# langchain-core: embry0.sandbox.runner uses RunnableConfig (type hint only,
# but imported at module load via cast()).
RUN pip install --no-cache-dir \
    "claude-agent-sdk==0.2.164" \
    "anthropic>=0.69,<1" \
    "structlog>=26.1,<27" \
    "httpx>=0.27,<1" \
    "langchain-core>=0.3,<1"

# Sandbox code (same layout as base image).
# embry0/agents/ + the docker_client/sandbox_manager/auth_provider/agent_runner
# subset are imported transitively from embry0.sandbox.runner -> executor_factory
# -> SdkAgentExecutor; the sandbox runner cannot start without them.
COPY embry0/sandbox/ /app/embry0/sandbox/
COPY embry0/safety/ /app/embry0/safety/
COPY embry0/agents/ /app/embry0/agents/
COPY embry0/execution/events.py /app/embry0/execution/events.py
COPY embry0/execution/agent_runner.py /app/embry0/execution/agent_runner.py
COPY embry0/execution/auth_provider.py /app/embry0/execution/auth_provider.py
COPY embry0/execution/docker_client.py /app/embry0/execution/docker_client.py
COPY embry0/execution/sandbox_manager.py /app/embry0/execution/sandbox_manager.py
RUN mkdir -p /app/embry0/execution \
    && touch /app/embry0/__init__.py /app/embry0/execution/__init__.py
ENV PYTHONPATH=/app

# QA-specific bundled scripts.
COPY infra/scripts/qa-compose /usr/local/bin/qa-compose
COPY infra/scripts/qa-ready-check.py /usr/local/bin/qa-ready-check
# Private-CA trust helper (spec 1A 3.2) — same helper as the slim image.
COPY infra/scripts/embry0-trust-ca /usr/local/bin/embry0-trust-ca
RUN chmod +x /usr/local/bin/qa-compose /usr/local/bin/qa-ready-check /usr/local/bin/embry0-trust-ca

# Non-root user (same convention as the slim image).
RUN useradd --create-home agent
# The vibium daemon chmods its socket dir (= VIBIUM_CACHE_DIR) at startup;
# chmod requires OWNERSHIP, not just write access, so a+rwX alone leaves the
# non-root agent failing with "chmod daemon dir: operation not permitted"
# (socket never appears, daemon start times out). Non-recursive chown is
# enough — the browser files inside stay root-owned + a+rwX.
RUN mkdir -p /workspace && chown agent:agent /workspace /opt/vibium

USER agent
WORKDIR /workspace

# Same build-time SDK check as the slim image (#497).
RUN home=$(mktemp -d) && HOME="$home" python -m embry0.agents.sdk_support && rm -rf "$home"
