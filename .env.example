# =============================================================================
# embry0 Configuration
# =============================================================================

# --- Database ---
# Required in production. Generate with: openssl rand -hex 20
# (defined before DATABASE_URL because compose interpolates env files top-down)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://embry0:${POSTGRES_PASSWORD}@postgres:5432/embry0
POSTGRES_DB=embry0
POSTGRES_USER=embry0

# --- Claude credential and models ---
# How agents authenticate to Anthropic, DEFAULT_AUTH_MODE:
#   oauth    (the default) a Claude subscription token, CLAUDE_CODE_OAUTH_TOKEN below.
#   api_key  per-token API billing, ANTHROPIC_API_KEY below. A Claude API key
#            account in the credential registry (Infra -> Credentials,
#            docs/credentials.md) takes precedence over the env value.
# Without the credential its mode needs, every job fails before it starts
# (ERR_CREDENTIAL_MISSING, ERR_MISSING_OAUTH_TOKEN or ERR_MISSING_API_KEY).
# A repo, a job or an agent can override the mode (docs/configuration.md,
# "Agent execution & auth modes").
# Uncomment to use an API key; leave commented for the oauth default.
# DEFAULT_AUTH_MODE=api_key
# DEFAULT_MODEL: a catalogue model id here puts EVERY agent on that model
# (docs/providers.md, "Default model"). Empty: each agent keeps its own.
# Read only until provider settings are first saved in the dashboard.
DEFAULT_MODEL=
MODEL_HEAVY=claude-opus-4-7
MODEL_MEDIUM=claude-sonnet-4-6
MODEL_LIGHT=claude-haiku-4-5

# Anthropic API key, for DEFAULT_AUTH_MODE=api_key.
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# Set true ONLY when something is wired to consume auth_proxy_url. The
# proxy holds ANTHROPIC_API_KEY in its env, so leave false unless needed.
AUTH_PROXY_ENABLED=false

# Claude Code OAuth token, for DEFAULT_AUTH_MODE=oauth. Used by sandbox-side
# Claude CLI runs and the Agent SDK triage calls (the orchestrator reads it
# from its environment). Get one with `claude setup-token`, or copy the
# accessToken from ~/.claude/.credentials.json (claudeAiOauth.accessToken).
CLAUDE_CODE_OAUTH_TOKEN=

# --- GitHub ---
# These forge tokens are an import source and a fallback since the credential registry (docs/credentials.md); run `embry0 credentials import-env` once and manage accounts in the dashboard (Infra → Credentials) or through the API.
GITHUB_TOKEN=ghp_your-github-personal-access-token
# Per-owner GitHub tokens: a fine-grained PAT is single-owner, so add one per
# org/user; GITHUB_TOKEN stays the global fallback. Owner is uppercased with
# '-' -> '_'. These live in THIS file (the repo-root .env is the
# orchestrator's env_file) — not infra/.env.
# GITHUB_TOKEN__MY_ORG=github_pat_...
# GITHUB_TOKEN__ANOTHER_ORG=github_pat_...
# Leave empty for local dev with smee.io (requires WEBHOOK_DEV_MODE=true below).
# For production, generate with: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=
# Repos you renamed on GitHub: a JSON object of old owner/repo -> current
# owner/repo. GitHub redirects an old URL but it no longer equals the one it
# reports, so merge sync and the healing ledger match a stored PR under
# either slug. Single-hop: map every old name straight to the current one.
# Read at startup; an entry that does not parse is logged
# (repo_renames_invalid) and skipped. Empty = no renames.
# REPO_RENAMES={"acme/old-name": "acme/new-name"}

# --- Budget & Limits ---
# Defaults are sized for trusted self-hosted operation (RAV-605); tighten
# for anything internet-facing. These are fallbacks only — a saved
# budget_config row (PUT /api/v1/config/budget, or Settings -> General)
# wins over every value here. A cap of 0 means unlimited.
# Per-job ceiling: bounds the budget_usd triage picks for a job.
MAX_BUDGET_USD=10.0
DAILY_BUDGET_CAP_USD=100.0
MONTHLY_BUDGET_CAP_USD=500.0
BUDGET_OVERRUN_MODE=soft
# Jobs one actor (webhook sender / API principal) may dispatch per hour.
RATE_LIMIT_PER_AUTHOR_PER_HOUR=5
API_RATE_LIMIT_PER_MINUTE=300
# Webhook request-body ceiling in bytes (5 MiB default).
MAX_WEBHOOK_BODY_BYTES=5242880
# Interrupt/resume cycle guards (rounds per job).
ASK_USER_ROUNDS_CAP=10
USER_RETRY_ROUNDS_CAP=5

# --- API ---
# REQUIRED unless AUTH_DEV_MODE=true — bearer token for the orchestrator API
# and dashboard. Startup refuses an empty value otherwise.
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
API_KEY=
# Dev-mode flags, for a local instance only. They are independent.
# AUTH_DEV_MODE: turns API authentication off, and is the only setting that
#   allows an empty API_KEY. For a local-only instance. NEVER use in production.
# WEBHOOK_DEV_MODE: skips webhook signature checks on routes without a secret,
#   and nothing else; API_KEY is still required. Needed for the smee.io relay.
# Startup refuses either flag when SSO (AUTH0_* / SSO_PUBLIC_ORIGIN) is set
# or this file carries a tunnel token (CLOUDFLARED_TUNNEL_TOKEN / TUNNEL_TOKEN):
# either means the instance has a public origin.
AUTH_DEV_MODE=false
WEBHOOK_DEV_MODE=false
ALLOWED_CORS_ORIGINS=http://localhost:3001
# Label that dispatches a job on every trigger surface. This is only the
# DEFAULT: once Settings → Integrations has been saved, the
# integration_config.trigger_labels DB row wins and this value is ignored.
# Startup logs `trigger_labels_effective` (label + source) and warns with
# `trigger_labels_env_shadowed` when the two disagree — keep them aligned.
TRIGGER_LABELS=embry0

# --- Secrets ---
# Fernet key for encrypting per-repo env var secrets at rest.
# Generate with: openssl rand -hex 32
# Required: startup refuses an empty value. Only with AUTH_DEV_MODE=true is
# a random key used instead, and secrets saved under it are lost on restart.
# Rotating this key makes previously-encrypted secrets undecryptable.
ENVIRONMENT_SECRET_KEY=

# Shared secret between orchestrator and credential proxies. Required in
# production. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
PROXY_ADMIN_TOKEN=
# How long a rate-limited or quota-exhausted LLM account stays out of the pool.
# A past until is usable again. Auth rejection has no window: an operator clears it.
# CREDENTIAL_RATE_LIMIT_QUARANTINE_SECONDS=900
# CREDENTIAL_QUOTA_QUARANTINE_SECONDS=3600
# xAI accounts. The registry is the source; these are the importer and the
# resolver's last step. XAI_PROXY_ENABLED launches the xai-proxy. The credential
# file wins over the Grok CLI file. See docs/credentials.md.
# XAI_API_KEY=
# XAI_CREDENTIAL_PATH=/data/embry0/xai_credential.enc
# XAI_GROK_CLI_STORE=
# XAI_PROXY_ENABLED=false
# OpenAI-compatible providers (docs/providers.md): off unless named here,
# comma-separated from openai, openrouter, google, groq, deepseek, custom.
# Their keys below are the resolver's last step and an import source, as
# XAI_API_KEY is; custom counts only with its base URL.
# OPENAI_COMPATIBLE_PROVIDERS=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=

# RAV-1140: context-proxy — mediated read-only log drill-down for watcher
# analysis jobs. The allowlist is the exact container names of the watched
# repo's deployment; empty leaves the proxy unlaunched (watcher runs
# briefing-only). Quota is lifetime queries per sandbox.
# An entry may be a glob pattern for containers named per release, e.g. blue/
# green slots: shop-api* admits shop-api-blue and shop-api-b-green. A name it
# admits must be letters, digits, - and _ only (it reaches a LogQL regex);
# entries without * ? [ stay exact names.
CONTEXT_PROXY_ENABLED=false
CONTEXT_PROXY_CONTAINER_ALLOWLIST=
CONTEXT_PROXY_QUERY_QUOTA=30
# SH-P4.4: lets a DEVELOPER job with log evidence (a linked healing case or a
# ticket "## Evidence" section naming an allowlisted container) query logs too,
# scoped to those containers, results redacted. Off by default — this lets a
# code-writing agent read production logs unattended. The evidence in the
# developer/reviewer prompts does not depend on this flag.
DEVELOPER_LOG_TOOL_ENABLED=false
# #294: payload field names whose values are personal data in the watched
# stack's logs (comma-separated, e.g. phone,customer_name). Their values are
# redacted, along with secrets and e-mail addresses, from every log line sent
# to a model provider or filed in a tracker.
# LOG_REDACTION_FIELDS=

# --- Sandbox Defaults ---
SANDBOX_IMAGE=embry0-sandbox:latest
# A sandbox's memory and CPU limits come from its sandbox profile
# (docs/configuration.md#runtime-configuration-api), not from this file.
# Most jobs running at once; the rest wait as `pending` (the board's "queued"
# lane) and start as slots free. 0 = no cap. Every sandbox shares DinD's
# DIND_MEMORY, so size this against it: docs/ops/provisioning.md, "Sizing
# DinD and the job cap".
MAX_RUNNING_JOBS=0
# On SIGTERM (a deploy, a restart) the orchestrator stops starting jobs and
# gives running ones this many seconds to reach a checkpoint; it resumes them
# when it is back. Keep it under the orchestrator's stop_grace_period in
# infra/docker-compose.yml minus 30 s (docs/ops/deploy.md).
SHUTDOWN_DRAIN_SECONDS=90
# Times boot resumes one job after a crash or kill (not a clean shutdown)
# before failing it with ERR_RESUME_LIMIT. 0 = never resume.
MAX_RESUME_ATTEMPTS=3
# Container registry prefix applied to embry0-* images at DinD-launch time.
# The bootstrapped compose stack runs a sidecar registry on the backend network
# (matching the value below). On a K8s migration this becomes the production
# registry URL (e.g. ghcr.io/your-org) — the same code paths apply, no rewrite
# needed. Empty disables qualification (useful for environments that side-load
# images directly into the daemon).
# The sidecar registry refuses anonymous clients, and the orchestrator runs the
# images it pushed by their recorded digest (#523). Nothing to set for either:
# the registry-auth-init service generates the login on first start, and
# compose hands the orchestrator REGISTRY_AUTH_DIR and IMAGE_PINS_FILE itself.
# See docs/ops/provisioning.md, "The registry login and the image pins".
IMAGE_REGISTRY=registry:5000
# Agent execution mode: the Agent SDK path. The auth mode is set under
# "Claude credential and models" at the top of this file.
# DEFAULT_EXECUTION_MODE=sdk
# How many hours a paused job keeps its sandbox alive before expiring.
PAUSED_JOB_TTL_HOURS=48
# DinD volume reaper (#274): startup + hourly sweep that removes per-job QA
# volumes whose owning job is terminal or has no jobs row. Only volumes stamped
# with this deployment's instance id are considered; the id is derived from the
# Postgres cluster + database name, so there is nothing to set for it (see
# docs/configuration.md). DRY_RUN=true logs
# `volume_reaper_would_remove` and removes nothing. ADOPT_LEGACY_NAMES=true
# also claims unlabelled `embry0-qa-vol-job-<id>` volumes created before
# ownership labels existed — enable once to drain that backlog, then unset.
# VOLUME_REAPER_ENABLED=true
# VOLUME_REAPER_DRY_RUN=false
# VOLUME_REAPER_INTERVAL_SECONDS=3600
# VOLUME_REAPER_ADOPT_LEGACY_NAMES=false
# VOLUME_REAPER_UNKNOWN_OWNER_GRACE_MINUTES=60

# --- Notifications (optional) ---
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public URL Telegram should call back when a user replies. Required for
# inbound Telegram answers (Plan B). Outbound notifications work without
# it. Example: https://embry0.your-tunnel.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Inbound replies are accepted only from TELEGRAM_CHAT_ID; everything else is
# dropped silently. Optionally narrow further to specific Telegram user ids
# (comma-separated) — useful when the chat is a shared group.
TELEGRAM_ALLOWED_SENDER_IDS=

# --- Dashboard public URL ---
# Used in GitHub-comment notifications as the deep-link users click to
# answer agent questions ("Answer at: <DASHBOARD_PUBLIC_URL>/issues/{id}").
# Localhost works for local dev; in production set to whatever public URL
# exposes the dashboard (Cloudflare tunnel, VPN host, etc.). Orchestrator
# logs a warning at startup if left at localhost outside dev mode.
DASHBOARD_PUBLIC_URL=http://localhost:8200

# --- Webhook public URL ---
# The public base URL forges deliver webhooks to (a webhooks tunnel hostname,
# for example), with no path; GitHub's hook URL is <it>/api/v1/webhook, and an
# organization webhook is installed pointing there. Organization
# discovery counts a repository's hook as pointing here only when its URL
# starts with it. DASHBOARD_PUBLIC_URL and SSO_PUBLIC_ORIGIN are not webhook
# origins: the public dashboard answers 404 on webhook paths. Unset or a
# loopback address, a repository's hooks are unknown, not absent, and the needs list asks for
# this setting (hook_origin_unknown) instead of guessing.
# WEBHOOK_PUBLIC_URL=https://webhooks.example.com

# --- Audit ---
AUDIT_LOG_PATH=/data/audit.jsonl
# Daily sweeper prunes audit_log rows + JSONL lines older than this (days)
AUDIT_RETENTION_DAYS=365

# --- Code retention (ADR 0017) ---
# Unset keeps everything, as before. See what a value would remove first:
#   GET /api/v1/admin/retention/preview?job_log_days=30&agent_session_days=30&qa_image_days=30 (admin)
# Days after which the code in a job's events (Write/Edit inputs, Bash
# commands, every tool result) is replaced by a marker that keeps the tool,
# file path, size and SHA-256. Only jobs that have ended; summary, cost and
# status stay.
# JOB_LOG_RETENTION_DAYS=30
# Days after which the saved agent sessions (the whole conversation) of ended
# jobs are deleted. A pull request comment follow-up on such a job then starts
# a fresh session instead of resuming the one that wrote the pull request.
# AGENT_SESSION_RETENTION_DAYS=30
# Days after which pre-built QA images (each a full checkout of the repo)
# and per-repo warm volumes that nothing has used are removed from the
# sandbox daemon. Never the image a repo's active qa_image_tags row names,
# nor an image or volume a container uses, nor a volume a live job's repo
# needs. Copies in the in-stack registry stay.
# QA_IMAGE_RETENTION_DAYS=30

# --- Context audit on a schedule (ADR 0020) ---
# Off until an organization sets settings.context_audit_days (PATCH
# /api/v1/orgs/{owner}); these bound what the schedule may spend. See
# docs/context-audit.md.
# Per-job cap for one context-audit job, always a HARD stop (nobody watches a
# scheduled audit), whatever BUDGET_OVERRUN_MODE says. 0 / inf / invalid falls
# back to the default.
# CONTEXT_AUDIT_JOB_BUDGET_USD=2.0
# Most jobs one tick (every 15 minutes) starts across every organization; the
# due repositories left over wait for the next tick. 0 starts none.
# CONTEXT_AUDIT_MAX_JOBS_PER_TICK=3

# --- Infrastructure ---
PROD_PORT=8200
ORCHESTRATOR_CPUS=4
ORCHESTRATOR_MEMORY=4G
DIND_CPUS=4
DIND_MEMORY=8G
TZ=America/New_York

# --- Cloudflare Tunnel (optional webhook ingress, docs/webhooks.md) ---
# The stack runs without it: the dashboard on :8200 works on the LAN, and only
# public webhook ingress needs a tunnel. The cloudflared service runs only with
# the `webhook-tunnel` compose profile. To run it, provision a Cloudflare
# tunnel (dashboard or `cloudflared tunnel create`), paste its token here, and
# enable the profile in the file compose reads: infra/.env when you run
# compose from infra/ (see infra/.env.example), or this file when you start
# the stack with `embry0 start`:
# COMPOSE_PROFILES=webhook-tunnel
# With the profile on and the token empty, cloudflared exits and restarts until
# a token is set. A token in this file also makes startup refuse AUTH_DEV_MODE
# and WEBHOOK_DEV_MODE, since it means the instance has a public origin.
# Set both keys to the same value (TUNNEL_TOKEN is the name cloudflared reads;
# CLOUDFLARED_TUNNEL_TOKEN is the canonical name used in this project).
CLOUDFLARED_TUNNEL_TOKEN=
TUNNEL_TOKEN=

# --- Off-host backup (optional, docs/ops/backup-restore.md) ---
# Copies the Postgres dumps and every MinIO bucket to an S3-compatible bucket
# off this host, with the `offhost-backup` compose profile. Compose reads
# these from the file it interpolates: infra/.env when you run compose from
# infra/ (see infra/.env.example, which describes each one), or this file
# when you start the stack with `embry0 start`. Set the path together with the
# profile: it also arms the staleness alert.
# COMPOSE_PROFILES=offhost-backup
# OFFHOST_BACKUP_S3_PATH=my-backups/embry0
# OFFHOST_BACKUP_S3_ENDPOINT=https://s3.example.com
# OFFHOST_BACKUP_S3_PROVIDER=Other
# OFFHOST_BACKUP_S3_REGION=
# OFFHOST_BACKUP_S3_ACCESS_KEY_ID=
# OFFHOST_BACKUP_S3_SECRET_ACCESS_KEY=
# OFFHOST_BACKUP_INTERVAL_SECONDS=3600

# MinIO — QA artifact storage (private bucket, served via orchestrator-side
# presigned URLs only). Do NOT expose ports publicly.
MINIO_ROOT_USER=embry0
# REQUIRED: generate with `openssl rand -hex 16` (compose refuses to start
# without it).
MINIO_ROOT_PASSWORD=
QA_ARTIFACT_RETENTION_DAYS=14
# MinIO endpoints — override only for non-compose deployments. The defaults
# match the compose service (orchestrator-side) and the in-DinD minio-proxy
# (sandbox-side, load-bearing for presigned-URL signatures).
# MINIO_ENDPOINT=minio:9000
# MINIO_SANDBOX_ENDPOINT=minio-proxy:9100

# --- Turbo remote cache (optional, infra/docker-compose.cache.yml) ---
# Auth token for the self-hosted turborepo-remote-cache overlay. Only needed
# when deploying that overlay; see the header of docker-compose.cache.yml.
# TURBO_REMOTE_CACHE_TOKEN=

# --- GitLab integration (optional, #164) ---
# Drives the inbound label trigger, clone/MR access, and note write-back.
# Leave GITLAB_TOKEN empty, with no GitLab credential in the registry, to
# disable — the webhook answers "not configured".
# GITLAB_URL=https://gitlab.com
# These forge tokens are an import source and a fallback since the credential registry (docs/credentials.md); run `embry0 credentials import-env` once and manage accounts in the dashboard (Infra → Credentials) or through the API.
# GITLAB_TOKEN=
# Per-namespace override, keyed on the TOP-LEVEL group. Access tokens are
# issued per group, so acme/products/widgets uses GITLAB_TOKEN__ACME
# (not ..._ACME_PRODUCTS).
# GITLAB_TOKEN__ACME=
# Shared secret GitLab sends in X-Gitlab-Token. NOTE: compared verbatim, not
# as an HMAC — unlike GitHub (sha256=<hmac>) and Linear (bare hex hmac).
# GITLAB_WEBHOOK_SECRET=
# Optional. A GitLab project IS the repo, so this defaults to identity and is
# only needed to point a project at a differently-named target.
# GITLAB_REPO_MAP={"acme/products/widgets": "acme/products/widgets"}
# Private CA for a self-managed instance whose certificate is not signed by a
# public CA. Two settings, and you need BOTH: GITLAB_CA_BUNDLE_HOST is the PEM's
# path ON THE HOST (compose bind-mounts it read-only), GITLAB_CA_BUNDLE is where
# the orchestrator reads it INSIDE the container. Only the second belongs in this
# file: GITLAB_CA_BUNDLE_HOST feeds compose ${...} interpolation, so it goes in
# infra/.env (ADR 0005), like the tunnel vars below. Leave both unset for
# gitlab.com. The bundle is read once at startup and reaches all three clients
# that need it: orchestrator httpx, the gitlab-proxy, and git inside sandboxes.
# An unreadable or non-certificate path refuses the boot, naming the path.
# Setting only GITLAB_CA_BUNDLE refuses the boot too (it reads the inert
# /dev/null mount); setting only GITLAB_CA_BUNDLE_HOST is a silent no-op — the
# PEM is mounted, never read, and clones fail their handshake later. Hence both.
# GITLAB_CA_BUNDLE_HOST=/etc/ssl/private/internal-ca.pem
# GITLAB_CA_BUNDLE=/etc/embry0/gitlab-ca.pem
# Forge assumed for a repo that has no row in the repo registry. "github"
# preserves historical behaviour. Set to empty to refuse unregistered repos:
# a job on an unknown repo then fails with ERR_REPO_UNREGISTERED instead of
# being cloned from github.com. Registration is manual — nothing registers a
# repo on first sight, webhooks included — so register each repo (POST
# /api/v1/repos, or the MCP repo_register tool) before its first job. With
# this empty, a registration that omits "forge" is refused with 422 rather
# than guessed, and storing a QA config no longer auto-registers either.
# DEFAULT_FORGE=github

# --- Linear integration (optional) ---
# Drives the inbound label trigger (POST /api/v1/webhook/linear), outbound
# write-back of job outcomes, AND the scripts/dispatch-embry0 CLI helper.
# All three settings are also editable in Settings -> Integrations; a value
# saved there wins over the env var. Leave the API key empty to disable the
# integration entirely — the webhook route answers "not configured".
# LINEAR_API_KEY=
# Signing secret for the Linear webhook. NOTE: Linear sends a bare hex
# HMAC-SHA256 in Linear-Signature, with no "sha256=" prefix (GitHub's
# convention). WEBHOOK_DEV_MODE=true bypasses verification when this is empty.
# LINEAR_WEBHOOK_SECRET=
# Static project→repo FALLBACK map (RAV-1397: routing is stamp-first — the
# Linear project's summary carries `repo: owner/name`; this JSON object of
# project name (or team key) → owner/repo is only consulted when no stamp
# resolves). An issue whose project has neither a stamp nor a map entry is
# ignored even when it carries the trigger label. Example:
# LINEAR_REPO_MAP={"Acme Platform": "acme/backend"}
# Dispatch reconciler: every interval, tickets in a backlog/unstarted/started
# state that carry the trigger label but have no job (a lost webhook) are sent
# through the same dispatch path as the webhook. It idles while Linear has no
# API key.
#   MODE  off    - never runs
#         shadow - DEFAULT. Takes every decision, changes nothing: no job, no
#                  ticket comment, no reopened issue. Logs
#                  linear_reconcile_would_dispatch / _would_skip / _would_reopen
#                  once per ticket and again only when the decision changes.
#         on     - acts. Promote from shadow once its log reads right.
# LINEAR_RECONCILE_MODE=shadow
# Seconds between sweeps; 0 also disables the loop.
# LINEAR_RECONCILE_INTERVAL_SECONDS=300
# The first sweep after a start waits this long, not a whole interval.
# LINEAR_RECONCILE_STARTUP_DELAY_SECONDS=90
# Bounds in `on` mode, all counted from the jobs table / dispatch ledger, so
# they hold across restarts. Reconciler jobs carry dispatched_by=linear-reconciler
# and are also subject to RATE_LIMIT_PER_AUTHOR_PER_HOUR and the budget caps.
# LINEAR_RECONCILE_MAX_DISPATCHES=3              # jobs started per sweep
# LINEAR_RECONCILE_MAX_DISPATCHES_PER_DAY=5      # jobs started per rolling 24 h
# LINEAR_RECONCILE_MAX_ATTEMPTS_PER_TICKET=2     # jobs it may ever start for one ticket
# A dispatch that raises before a job exists is retried with exponential
# backoff (interval, doubling, max 6 h) and abandoned after this many failures.
# LINEAR_RECONCILE_FAILURE_MAX_ATTEMPTS=5
# Reopen Linear issues stuck in `triaging` with no live job for this many
# minutes (orchestrator died mid-dispatch). 0 disables.
# LINEAR_RECONCILE_STALE_TRIAGING_MINUTES=15

# ─── Verification after review (#298, #299) — docs/verification.md ──────────
# shadow (DEFAULT) | on | off. After the reviewer approves, embry0 tiers the
# diff and runs the repo's stored test commands on base and head (no model
# spend). shadow decides and stores but changes no routing and writes nothing
# to GitHub/GitLab; `on` additionally blocks a job on a NEW test failure,
# prunes browser QA by tier, and posts the verdict + human-merge-only label.
# An unrecognised value is treated as shadow. The deployed-target QA fix is
# structural and applies in every mode.
# VERIFICATION_MODE=shadow
# Base URL + API key of the embry0 instance the CLI helper POSTs to.
# EMBRY0_URL=http://localhost:8200
# EMBRY0_API_KEY=

# --- Watcher / proposer (optional, RAV-657) ---
# Scheduled Loki log-scan → analysis job → DRAFT Linear ticket. Off by default.
# WATCHER_ENABLED=true
# The first tick after a (re)start is scheduled from the last recorded tick,
# not from process start; an overdue one waits this long first.
# WATCHER_STARTUP_DELAY_SECONDS=90
# WATCHER_LOKI_URL=http://loki:3100
# Needed when WATCHER_ENABLED=true — there is no code default. Selects the
# watched stack's error lines. Write PLAIN double quotes. Do NOT
# backslash-escape them: .env values are read verbatim, Loki receives the
# backslashes and answers 400.
# This and WATCHER_DEPLOY_LOGQL are probed against Loki when the watcher
# starts, and again every interval while unhealthy. A fault never stops the
# orchestrator; it logs CRITICAL, turns /api/v1/health/ready degraded and
# STOPS THE TICKS until the probe passes (no restart needed once fixed):
#   unset/blank        watcher_logql_missing       checks.watcher=missing_logql
#   Loki 400/422       watcher_logql_invalid       checks.watcher=invalid_logql
#   other 4xx (404…)   watcher_loki_misconfigured  checks.watcher=loki_misconfigured
#                      → check WATCHER_LOKI_URL / auth, not the query
# An unreachable Loki (connection error, timeout, 429, 5xx) only warns
# (checks.watcher=unverified) and ticking continues.
#
# The `|~` match is on the message BODY, so on its own it also selects DEBUG
# and INFO lines that merely contain the word "error" — measured at 17.6% of
# the stream on a production stack, where the two loudest signatures in a 24h
# window were both noise (#368). The trailing stage expression drops them by
# LEVEL. Unlevelled lines (nginx, Java stack frames, Postgres continuation
# SQL) are kept deliberately: they are 54% of what survives and mostly
# genuine. That works because a `regexp` stage which does not match sets no
# labels and — unlike `json`/`logfmt` — no `__error__`, so `lvl = ""` lets
# them through.
# Note the backslashes below are NOT the escaping warned about above: that
# warning is about the double-quote character. `\\S` is a Go string escape
# inside a LogQL literal and is required — written `\S` Loki answers 400.
# Keep this in sync with LOGQL_LEVEL_EXCLUSION in
# embry0/services/log_levels.py, which applies the same rule in-process so the
# guarantee holds whatever is set here.
# WATCHER_LOGQL={compose_project="my-stack"} |~ "(?i)(error|exception|traceback)" | regexp "^\\S+\\s+(?P<lvl>TRACE|DEBUG|INFO|TRC|DBG|INF)\\s" | lvl = ""
# Deploy markers for the analysis briefing (each matching line = one deploy).
# Empty disables the section.
# WATCHER_DEPLOY_LOGQL={job="my-stack-deploy"}
# WATCHER_REPO=owner/repo
# WATCHER_LINEAR_TEAM_ID=
# Per-job cap for one analysis job, always a HARD stop (ticks run unattended),
# whatever BUDGET_OVERRUN_MODE says. Checked between agent turns: worst case
# is the cap plus one full turn. 0 / inf / invalid falls back to the default.
# WATCHER_JOB_BUDGET_USD=2.0
# A tick's Loki window starts where the last analysed window ended; this bounds
# how far back it may reach after skipped/errored ticks or an outage (never
# below one interval). Contiguous in time only — the excerpt line cap still applies.
# WATCHER_MAX_LOOKBACK_SECONDS=21600
#
# Deterministic log-signature clustering (#289). off | shadow | on.
#   off    : no clustering, no rows written
#   shadow : cluster, persist and log, but the prompt keeps the raw tail so the
#            agent's own grouping stays in effect and the two can be compared
#   on     : the ranked cluster table replaces the raw tail in the prompt
# Clustering also feeds the dedupe key (#290) and the skip decision below, and
# both of those need the persisted history — so `off` turns them off too.
# LOG_CLUSTERING_MODE=shadow
#
# Skip the paid analysis when the window holds nothing new (#291).
# off | shadow | on.
#   off    : every tick with enough lines is analysed (pre-#291 behaviour)
#   shadow : the decision is computed and logged as watcher_skip_shadow, and
#            the analysis runs anyway — so the ticks it WOULD have skipped can
#            be checked against what they actually found before you trust it
#   on     : an unchanged window is recorded as `no_change`, with no job
# A `no_change` tick counts as analysed: it advances the query window and
# refreshes the dead-man gauge, because it did judge its window. The hole that
# leaves — a broken comparator skipping everything — is watched by
# Embry0WatcherNeverAnalyses24h in the monitoring stack.
# WATCHER_SKIP_UNCHANGED_MODE=shadow
#
# What makes a signature interesting, for both the dedupe and the skip.
# A spike needs BOTH the ratio and the absolute floor: log volume is bursty,
# and without the floor a signature going from 1 line to 3 reads as a 3x
# emergency. Regression silence is how long a signature must be absent before
# its return counts as a regression rather than a gap (6h = six hourly ticks).
# WATCHER_SPIKE_FACTOR=3.0
# WATCHER_SPIKE_MIN_COUNT=10
# WATCHER_REGRESSION_SILENCE_SECONDS=21600

# --- Confirm-healed (#312, on by default) ---
# After a fix's deploy marker, count the case's signature over a window scaled
# to the rate it ran at BEFORE the fix, and record healed / not_healed /
# inconclusive with the counts. Nothing checked this before: a ticket was once
# closed while its exception was still logging 22-82 lines a day.
# ON rather than shadow, unlike every other autonomy stage, because it only
# reads the ledger and comments on a ticket.
# CONFIRM_HEALED_ENABLED=true
# CONFIRM_HEALED_INTERVAL_SECONDS=1800
# CONFIRM_HEALED_STARTUP_DELAY_SECONDS=120

# --- Merge approvals from a chat (#319 phase 2, dry run by default) ---
# A completed job's PR on one of these repos is asked about in the operator's
# approval chat (outbound event `merge.approval_requested`, posted by a chat
# relay that consumes outbound webhooks). A reply relayed through
# the `merge_decide` MCP tool is checked here — the chat, the PR head sha, CI,
# the verification gate, GitHub's mergeability — and squash-merged.
# dry_run records the decision and reports "would merge" with no GitHub write;
# on merges. Any other value is treated as dry_run.
# MERGE_APPROVAL_MODE=dry_run
# Comma-separated owner/repo. Empty (the default) asks about no PR at all, and
# startup logs `merge_approvals_no_repos` to say so.
# MERGE_APPROVAL_REPOS=acme/backend,acme/frontend
# The ONLY chat whose answers count, as the relay identifies it.
# Empty refuses every decision. The relay should hold a `merge`-scope API key:
# it can read, decide merges and answer agent questions, and nothing else.
# MERGE_APPROVAL_CHAT_ID=
# The ask waits for the commit's CI (so its recommendation reads real CI), up
# to this many minutes. Unanswered asks retire themselves: closed when the PR
# is merged/closed on GitHub, expired after the expiry.
# MERGE_APPROVAL_CI_WAIT_MINUTES=45
# MERGE_APPROVAL_EXPIRY_DAYS=7
# MERGE_APPROVAL_SWEEP_SECONDS=60

# --- Alertmanager as a detection source (#296, optional) ---
# Prometheus/Alertmanager/Loki could page a chat but not open a case; with
# this set, a firing alert becomes a healing case readable over MCP.
# Alertmanager cannot HMAC a body, so it presents this secret whole as
# `Authorization: Bearer <secret>`. Empty = the receiver answers 503 outside
# dev mode, the same posture as every other webhook here.
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# The same value goes in the monitoring stack's .env as
# ALERTMANAGER_WEBHOOK_TOKEN.
# ALERTMANAGER_WEBHOOK_SECRET=
#
# healing_cases.repo is NOT NULL and guessing would file against the wrong
# repo, so an alert that resolves to no repo is DROPPED with a logged reason.
# Resolution order: the alert's own `repo` label, then this map matched against
# the service / container_name / name / job label VALUES, then WATCHER_REPO.
# An unparseable value maps nothing and logs — it never stops startup.
# ALERTMANAGER_REPO_MAP={"backend": "acme/backend"}

# --- Auth0 SSO for the public dashboard (RAV-1069, optional) ---
# All-or-nothing: setting SOME of these refuses startup. Fully unset = SSO
# off (LAN API-key auth only). Configure a confidential client on your own
# Auth0 tenant. Access is DEFAULT-DENY: users need the embry0-operator
# (access) or embry0-admin (env reveals + agent/config mutations) role.
# AUTH0_ISSUER=https://example-tenant.us.auth0.com/
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# Signs the embry0_session cookie (>=32 chars). Rotating it logs everyone out.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# SESSION_SECRET=
# Public origin — must match the callback URL registered on the Auth0 client.
# Its hostname also goes in infra/.env as DASHBOARD_PUBLIC_HOSTNAME (below).
# SSO_PUBLIC_ORIGIN=https://embry0.example.com
# The ID-token claim your tenant's post-login Action stamps the roles onto.
# Required when SSO is on and deployment-specific, so there is no default: a
# claim that does not match yields NO roles for everyone, and default-deny
# then refuses them all with nothing in the log to say why. Must be on the ID
# token, not the access token. A tenant-wide namespace is usually right.
# SSO_ROLES_CLAIM=https://example.com/roles

# --- Public dashboard tunnel (infra/.env, not this file) ---
# CF_API_TOKEN, CF_TUNNEL_ID and CF_RUN_USER live in infra/.env — they feed
# docker-compose interpolation and infra/cloudflared-dashboard/provision.sh,
# never a container env. See docs/sso.md.
#
# DASHBOARD_PUBLIC_HOSTNAME also lives in infra/.env; compose passes it to the
# frontend (nginx) and to the dashboard tunnel's config render, nothing else.
# Set it to the public dashboard's hostname, the host part of
# SSO_PUBLIC_ORIGIN, with no scheme, port or path. The frontend then serves
# that Host from a hardened vhost: webhook, telegram and internal API paths
# refused, X-Forwarded-Proto https, CSP and HSTS. The tunnel routes only that
# Host to nginx, and provision.sh points the CNAME at it. Unset = no public
# vhost (every Host gets the LAN vhost) and a dashboard tunnel that refuses to
# start. A value that is not one plain hostname stops both. Apply with
# infra/deploy.sh frontend and
# docker compose --profile dashboard-tunnel up -d cloudflared-dashboard.
# DASHBOARD_PUBLIC_HOSTNAME=embry0.example.com
